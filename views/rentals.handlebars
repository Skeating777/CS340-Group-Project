<h1>Rentals</h1>

<section>
    <h2>Browse Rentals</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Customer</th>
                <th>Bike Model</th>
                <th>Rental Date</th>
                <th>Return Date</th>
                <th>Hour Meter Out</th>
                <th>Hour Meter In</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{#each rentals}}
            <tr>
                <td>{{rentalID}}</td>
                <td>{{customerName}}</td>
                <td>{{modelName}}</td>
                <td>{{displayDatetime rentalDate}}</td>
                <td>{{displayDatetime returnDate}}</td>
                <td>{{hourMeterOut}}</td>
                <td>{{hourMeterIn}}</td>
                <td>
                    <a href="/rentals/edit/{{rentalID}}">Edit</a>
                    <form action="/rentals/delete" method="POST" style="display:inline">
                        <input type="hidden" name="rentalID" value="{{rentalID}}">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section>
    <h2>Add New Rental</h2>
    <form action="/rentals/add" method="POST">
        <label>Customer
            <select name="customerID" required>
                <option value="">-- Select Customer --</option>
                {{#each customers}}
                <option value="{{customerID}}">{{customerName}}</option>
                {{/each}}
            </select>
        </label>
        <label>Bike
            <select name="bikeID" required>
                <option value="">-- Select Bike --</option>
                {{#each bikes}}
                <option value="{{bikeID}}">{{bikeLabel}}</option>
                {{/each}}
            </select>
        </label>
        <label>Rental Date
            <input type="datetime-local" name="rentalDate" step="1" required>
        </label>
        <label>Return Date
            <input type="datetime-local" name="returnDate" step="1" required>
        </label>
        <label>Hour Meter Out
            <input type="number" name="hourMeterOut" step="0.1" min="0" required>
        </label>
        <label>Hour Meter In
            <input type="number" name="hourMeterIn" step="0.1" min="0" required>
        </label>
        <button type="submit">Add Rental</button>
    </form>
</section>
