<h1>Edit Rental</h1>

<form action="/rentals/update" method="POST">
    <input type="hidden" name="rentalID" value="{{rental.rentalID}}">
    <label>Customer
        <select name="customerID" required>
            {{#each customers}}
            <option value="{{customerID}}" {{selected customerID ../rental.customerID}}>{{firstName}} {{lastName}}</option>
            {{/each}}
        </select>
    </label>
    <label>Bike
        <select name="bikeID" required>
            {{#each bikes}}
            <option value="{{bikeID}}" {{selected bikeID ../rental.bikeID}}>{{modelName}} ({{frameNumber}})</option>
            {{/each}}
        </select>
    </label>
    <label>Rental Date
        <input type="datetime-local" name="rentalDate" value="{{formatDatetime rental.rentalDate}}" required>
    </label>
    <label>Return Date
        <input type="datetime-local" name="returnDate" value="{{formatDatetime rental.returnDate}}" required>
    </label>
    <label>Hour Meter Out
        <input type="number" name="hourMeterOut" value="{{rental.hourMeterOut}}" step="0.1" min="0" required>
    </label>
    <label>Hour Meter In
        <input type="number" name="hourMeterIn" value="{{rental.hourMeterIn}}" step="0.1" min="0" required>
    </label>
    <button type="submit">Update Rental</button>
    <a href="/rentals">Cancel</a>
</form>
